[Unit]
Description=Textile ERP tunnel and app health watchdog
After=network-online.target textile-erp.service textile-tunnel.service

[Service]
Type=simple
WorkingDirectory=@WORKSPACE@
Environment=ERP_PUBLIC_URL=https://erp.kutalimzhda.com
Environment=WATCHDOG_INTERVAL_SEC=10
Environment=TUNNEL_MIN_HA_CONNECTIONS=2
ExecStart=@WORKSPACE@/scripts/tunnel-watchdog.sh
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
