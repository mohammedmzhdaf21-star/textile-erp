[Unit]
Description=Textile ERP Cloudflare named tunnel (erp.kutalimzhda.com)
After=network-online.target textile-erp.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@WORKSPACE@
Environment=PORT=3000
Environment=ERP_PUBLIC_URL=https://erp.kutalimzhda.com
Environment=TUNNEL_METRICS_PORT=20241
ExecStart=@WORKSPACE@/scripts/run-named-tunnel.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
