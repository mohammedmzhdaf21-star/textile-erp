{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist"
  },
  "include": [
    "src/lib/**/*.ts",
    "src/middleware/**/*.ts",
    "src/routes/**/*.ts",
    "src/server.ts",
    "src/types/**/*.d.ts",
